<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Agendamentos | Pediatria</title>

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #f1f6fb;
        color: #243b53;
        font-family: Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
      }
      a {
        color: #216eae;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      .app-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 5%;
        background: #174a78;
        color: white;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: white;
      }
      .brand:hover {
        color: white;
        text-decoration: none;
      }
      .brand strong,
      .brand small {
        display: block;
        color: white;
      }
      .brand small {
        color: #d4e7f7;
        font-size: 12px;
      }
      .brand-mark {
        display: block;
        padding: 5px 12px;
        border: 1px solid #ffffff70;
        border-radius: 8px;
        color: white;
        font-size: 24px;
      }
      .main-nav {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .main-nav a {
        color: white;
      }
      .main-nav a.active {
        font-weight: bold;
        text-decoration: underline;
      }
      .account-menu {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .welcome {
        color: #e3f0fa;
        white-space: nowrap;
      }
      .welcome strong {
        color: white;
      }
      .account-menu form {
        margin: 0;
      }
      button {
        padding: 10px 16px;
        border: 0;
        border-radius: 6px;
        background: #216eae;
        color: white;
        cursor: pointer;
        font-size: 14px;
      }
      button:hover {
        background: #174a78;
      }
      button.button-quiet {
        padding: 8px 13px;
        border: 1px solid #ffffff80;
        background: transparent;
      }
      [role="alert"] {
        margin: 16px 0;
        padding: 12px;
        border: 1px solid #e8b8c1;
        border-radius: 6px;
        background: #fff1f3;
        color: #913548;
      }
      @media (max-width: 700px) {
        .app-header {
          flex-wrap: wrap;
          padding: 14px 18px;
        }
        .main-nav {
          order: 3;
          width: 100%;
          flex-wrap: wrap;
          gap: 12px;
        }
        .account-menu {
          margin-left: auto;
        }
      }

      main {
        max-width: 1120px;
        margin: 36px auto;
        padding: 0 22px;
      }
      h1 {
        margin: 0 0 8px;
        color: #123b63;
        font-size: 30px;
      }
      main > p {
        margin: 12px 0 22px;
      }
      main > p > a {
        display: inline-block;
        padding: 10px 15px;
        border-radius: 6px;
        background: #216eae;
        color: white;
      }
      main > p > a:hover {
        background: #174a78;
        text-decoration: none;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        background: white;
      }
      th {
        padding: 14px 16px;
        background: #dcecf8;
        color: #174a78;
        text-align: left;
      }
      td {
        padding: 14px 16px;
        border-bottom: 1px solid #d9e3ec;
        vertical-align: middle;
      }
      tbody tr:hover {
        background: #f7fbfe;
      }
      td form {
        display: inline-block;
        margin: 0 0 0 10px;
      }
      td form button {
        padding: 7px 11px;
        background: #e7f1f9;
        color: #174a78;
      }
      td form button:hover {
        background: #d5e8f7;
      }
      @media (max-width: 700px) {
        main {
          margin: 24px auto;
          padding: 0 14px;
        }
        table {
          display: block;
          overflow-x: auto;
          white-space: nowrap;
        }
        th,
        td {
          padding: 11px 12px;
        }
      }
    </style>
  </head>
  <body>
    <header class="app-header">
      <a
        class="brand"
        href="/agendamentos"
        aria-label="Pediatria, página inicial"
      >
        <span class="brand-mark" aria-hidden="true">🩺</span>
        <span>Pediatria</span>
      </a>
      <nav class="main-nav" aria-label="Navega??o principal">
        <a
          class="<%= currentPath.startsWith('/agendamentos') ? 'active' : '' %>"
          href="/agendamentos"
          >Agendamentos</a
        >
        <a
          class="<%= currentPath.startsWith('/criancas') ? 'active' : '' %>"
          href="/criancas"
          >Crianças</a
        >
        <a
          class="<%= currentPath.startsWith('/responsaveis') ? 'active' : '' %>"
          href="/responsaveis"
          >Responsáveis</a
        >
      </nav>
      <div class="account-menu">
        <span class="welcome"
          >Olá, <strong><%= usuario ? usuario.nome : '' %></strong></span
        >
        <form action="/logout" method="post">
          <button class="button-quiet" type="submit">Sair</button>
        </form>
      </div>
    </header>
    <main>
      <h1>Agendamentos</h1>
      <p><a href="/agendamentos/novo">Novo agendamento</a></p>
      <table>
        <thead>
          <tr>
            <th>Data</th>
            <th>Hora</th>
            <th>Motivo</th>
            <th>Criança</th>
            <th>Responsável</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% agendamentos.forEach(a=>{ %>
          <tr>
            <td>
              <%= new Date(a.data_agendada).toLocaleDateString('pt-BR',{timeZone:'UTC'}) %>
            </td>
            <td><%= String(a.hora_agendada).slice(0,5) %></td>
            <td><%= a.motivo %></td>
            <td><%= a.nome_da_crianca %></td>
            <td><%= a.nome_do_responsavel %></td>
            <td>
              <a href="/agendamentos/editar/<%= a.id_agendamento %>">Editar</a>
              <form
                action="/agendamentos/excluir/<%= a.id_agendamento %>"
                method="post"
                onsubmit="return confirm('Excluir este agendamento?');"
              >
                <button>Excluir</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </body>
</html>
