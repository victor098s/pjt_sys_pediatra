<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Novo agendamento | Pediatria</title>
    <style>
      body {
        font: 16px Arial;
        background: #f4f7fb;
        color: #192b43;
      }
      .wrap {
        max-width: 700px;
        margin: 40px auto;
        background: white;
        padding: 28px;
        border-radius: 12px;
      }
      label {
        display: block;
        margin: 14px 0;
      }
      input,
      select {
        display: block;
        width: 100%;
        box-sizing: border-box;
        padding: 10px;
        margin-top: 5px;
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <a href="/agendamentos">← Agendamentos</a>
      <h1>Novo agendamento</h1>
      <% if(erro){ %>
      <p role="alert"><%= erro %></p>
      <% } %>
      <form action="/agendamentos/novo" method="post">
        <label>Data<input name="data_agendada" type="date" required /></label
        ><label>Hora<input name="hora_agendada" type="time" required /></label
        ><label>Motivo<input name="motivo" maxlength="120" required /></label
        ><label
          >Criança<select name="crianca" required>
            <option value="">Selecione</option>
            <% criancas.forEach(c=>{ %>
            <option value="<%= c.id %>"><%= c.nome %></option>
            <% }) %>
          </select></label
        ><label
          >Responsável<select name="responsavel" required>
            <option value="">Selecione</option>
            <% responsaveis.forEach(r=>{ %>
            <option value="<%= r.id %>"><%= r.nome %></option>
            <% }) %>
          </select></label
        ><button type="submit">Agendar</button>
      </form>
    </main>
  </body>
</html>
